{
  "name": "dsh-minimax-autoread",
  "version": "0.1.0",
  "description": "Read DeepSeek Harness replies out loud with MiniMax voices: a per-message speaker button plus optional auto-read · DeepSeek Harness 的 MiniMax 朗读插件：每条回复一个喇叭按钮，可自动朗读",
  "type": "module",
  "license": "MIT",
  "author": "sorooy",
  "homepage": "https://github.com/sorooy/dsh-minimax-autoread#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorooy/dsh-minimax-autoread.git"
  },
  "bugs": {
    "url": "https://github.com/sorooy/dsh-minimax-autoread/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "minimax",
    "tts",
    "text-to-speech",
    "read-aloud",
    "语音朗读"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
