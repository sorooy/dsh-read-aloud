{
  "name": "dsh-minimax-autoread",
  "version": "0.3.0",
  "description": "给 DeepSeek Harness 加语音朗读：每条回复一个喇叭按钮，点一下就用 MiniMax 音色念出来；支持每轮自动朗读、发消息立即打断。DeepSeek Harness TTS plugin powered by MiniMax.",
  "type": "module",
  "license": "MIT",
  "author": "时时",
  "homepage": "https://gitee.com/op00007/dsh-minimax-autoread#readme",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/op00007/dsh-minimax-autoread.git"
  },
  "bugs": {
    "url": "https://gitee.com/op00007/dsh-minimax-autoread/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-plugin-tts",
    "cordis",
    "minimax",
    "tts",
    "text-to-speech",
    "read-aloud",
    "voice",
    "语音",
    "语音朗读",
    "文字转语音"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
